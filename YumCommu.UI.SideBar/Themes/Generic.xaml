<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:YumCommu.UI">

  <!-- SideBar コントロールテンプレート -->
  <Style TargetType="local:SideBar">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="local:SideBar">
          <Grid>
            <Grid.ColumnDefinitions>
              <!-- col 0: アイコンエリア (常に表示) -->
              <ColumnDefinition Width="48"/>
              <!-- col 1: メニューエリア (Docked 時に幅を確保) -->
              <ColumnDefinition x:Name="PART_MenuColumn" Width="0"/>
              <!-- col 2: メインコンテンツエリア -->
              <ColumnDefinition Width="*"/>
              <!-- col 3: プロパティエリア -->
              <ColumnDefinition x:Name="PART_PropertyColumn" Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- アイコンエリア: 常に表示 -->
            <Border Grid.Column="0"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0">
              <StackPanel x:Name="PART_IconPanel"
                          Spacing="2"
                          Padding="4"
                          VerticalAlignment="Top"/>
            </Border>

            <!-- メニューパネル: Docked は col 1、Overlay は col 2 に code-behind で切替 -->
            <Border x:Name="PART_MenuPanel"
                    Grid.Column="1"
                    Width="280"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Stretch"
                    Visibility="Collapsed"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0">
              <Grid>
                <ContentPresenter x:Name="PART_MenuContent"/>
                <!-- リサイズハンドル: IsMenuResizable=True のとき code-behind で Visible に -->
                <Grid x:Name="PART_MenuResizer"
                      Width="5"
                      HorizontalAlignment="Right"
                      Background="Transparent"
                      Visibility="Collapsed"/>
              </Grid>
            </Border>

            <!-- メインコンテンツエリア -->
            <ContentPresenter x:Name="PART_MainContent"
                              Grid.Column="2"
                              Content="{TemplateBinding Content}"/>

            <!-- プロパティエリア -->
            <ContentPresenter x:Name="PART_PropertyContent"
                              Grid.Column="3"
                              Content="{TemplateBinding PropertyPanel}"/>

            <!-- オーバーレイバックドロップ: Overlay 時に外側クリックを検知して閉じる -->
            <Grid x:Name="PART_OverlayBackdrop"
                  Grid.Column="2"
                  Grid.ColumnSpan="2"
                  Background="Transparent"
                  Visibility="Collapsed"
                  Canvas.ZIndex="5"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- SideBarIcon コントロールテンプレート -->
  <Style TargetType="local:SideBarIcon">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="local:SideBarIcon">
          <ToggleButton x:Name="TabBtn"
                      Style="{StaticResource SideBarButtonStyle}"
                      IsChecked="{TemplateBinding IsSelected}"
                      AutomationProperties.Name="{TemplateBinding Name}"
                      ToolTipService.ToolTip="{TemplateBinding ToolTip}"
                      Content="{TemplateBinding Content}"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- SideBarIcon 内で使用するボタンスタイル -->
  <Style x:Key="SideBarButtonStyle" TargetType="ToggleButton">
    <Setter Property="Width" Value="40"/>
    <Setter Property="Height" Value="40"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid x:Name="RootGrid"
                CornerRadius="{TemplateBinding CornerRadius}"
                Background="Transparent">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal"/>
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="RootGrid.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="RootGrid.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}"/>
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="ContentPresenter.Opacity" Value="0.5"/>
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Checked">
                  <VisualState.Setters>
                    <Setter Target="RootGrid.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                    <Setter Target="SelectionIndicator.Visibility" Value="Visible"/>
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedPointerOver">
                  <VisualState.Setters>
                    <Setter Target="RootGrid.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                    <Setter Target="SelectionIndicator.Visibility" Value="Visible"/>
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedPressed">
                  <VisualState.Setters>
                    <Setter Target="RootGrid.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}"/>
                    <Setter Target="SelectionIndicator.Visibility" Value="Visible"/>
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <!-- 選択中を示す左端のアクセントバー -->
            <Border x:Name="SelectionIndicator"
                    Width="3" Height="20"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    CornerRadius="0,2,2,0"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    Visibility="Collapsed"/>

            <ContentPresenter x:Name="ContentPresenter"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Content="{TemplateBinding Content}"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
